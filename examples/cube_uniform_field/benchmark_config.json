{
  "description": "Benchmark configuration for cube_uniform_field examples (Radia)",
  "note": "Each benchmark runs in subprocess for accurate memory measurement",

  "nonlinear": {
    "hexahedron": {
      "script": "nonlinear/hexahedron/benchmark_hex.py",
      "solvers": ["lu", "bicgstab", "hacapk"],
      "n_div": [10, 15]
    },
    "tetrahedron": {
      "script": "nonlinear/tetrahedron/benchmark_tetra.py",
      "solvers": ["lu", "bicgstab", "hacapk"],
      "maxh": [0.20, 0.15, 0.10]
    }
  },

  "linear": {
    "hexahedron": {
      "script": "linear/benchmark_hexahedron.py",
      "solvers": ["lu", "bicgstab", "hacapk"],
      "n_div": [10, 15, 20]
    },
    "tetrahedron": {
      "script": "linear/benchmark_tetrahedron.py",
      "solvers": ["lu", "bicgstab", "hacapk"],
      "maxh": [0.20, 0.15, 0.10, 0.05]
    }
  },

  "full_suite": {
    "description": "Complete benchmark suite for all element types and solvers",
    "benchmarks": [
      {"type": "linear/hexahedron", "n_div": [5, 10, 15], "solvers": ["lu", "bicgstab", "hacapk"]},
      {"type": "linear/tetrahedron", "maxh": [0.20, 0.15, 0.10], "solvers": ["lu", "bicgstab", "hacapk"]}

      {"type": "nonlinear/hexahedron", "n_div": [10, 15], "solvers": ["lu", "bicgstab", "hacapk"]},
      {"type": "nonlinear/tetrahedron", "maxh": [0.20, 0.15, 0.10], "solvers": ["lu", "bicgstab", "hacapk"]},

      {"type": "nonlinear/hexahedron", "n_div": [20], "solvers": ["hacapk"]},
      {"type": "nonlinear/tetrahedron", "maxh": [0.05], "solvers": ["lu", "bicgstab", "hacapk"]},
    ]
  },

  "solver_methods": {
    "lu": {"method": 0, "description": "Dense LU decomposition (LAPACK dgesv)"},
    "bicgstab": {"method": 1, "description": "BiCGSTAB with Jacobi preconditioner"},
    "hacapk": {"method": 2, "description": "BiCGSTAB with H-matrix (ACA+)"}
  },

  "default_params": {
    "nonl_tol": 0.001,
    "bicg_tol": 1e-4,
    "hmat_eps": 1e-5,
    "hmat_leaf_size": 10,
    "hmat_eta": 2.0
  }
}

!examples/Universal_Relaxation_Network/results/*.csv
!examples/peec_integration/data/*.csv

# ============================================================================
# IMPORTANT: PyPI Distribution Files - DO NOT IGNORE
# ============================================================================
# The following files are tracked and required for PyPI distribution:
# - setup.py
# - pyproject.toml
# - MANIFEST.in
# - LICENSE
# - COPYRIGHT.txt
#
# Note: Build_PyPI_Package.ps1 is now ignored (merged into Build_Wheel.ps1)


# ============================================================================
*.pyd
*.ccm
*.so
*.dll
*.dylib
*.o
*.obj

# Mathematica notebooks: manage as .wls, never .nb
# (CLAUDE.md policy "Mathematica Content: .wls Not .nb")
*.nb

# But DO track the Cubit plugin .ccm/.ccl — they ship in the
# cubit-mesh-export wheel and CI does not rebuild them. .pyd is
# intentionally NOT tracked (Policy 2 bans .pyd in git, and it is an
# optional Cubit-less HO meshing module). Wheel ships .ccm + .ccl only.
!src/radia/cubit_mesh_export.ccm
!packages/cubit-mesh-export/src/cubit_mesh_export/cubit_mesh_export.ccm
!packages/cubit-mesh-export/src/cubit_mesh_export/cubit_mesh_export.ccl
*.exe
*.out
*.app
*.lib
*.exp
*.ilk
*.pdb
*.iobj
*.ipdb
*.zip
*.whl

# Precomputed matrices (regenerated at runtime)
laplace_*.dat
dipole_*.dat


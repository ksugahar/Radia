src/radia/panels/samples/*_fem_coilmesh_*.sol
src/radia/panels/samples/*_wp.msh
src/radia/panels/samples/*_wp.msh.opt
# Stale "v2"-suffixed solver outputs are NEVER tracked
src/radia/panels/samples/*_v2*


src/radia/panels/samples/*_analytic.sol
src/radia/panels/samples/3turnCoil.*

# Solver-generated output files in panels/samples/ (regenerated by running
# the panel against the .jou input).  Keep input geometry (.jou, .step,
# .vol when generated by export from the .jou) but ignore everything
# downstream of the solver.  Per "Panel Samples Quality Policy" in
# CLAUDE.md, samples/ should hold only validated inputs that ship in the
# wheel -- not solver outputs (which are debug artifacts).
src/radia/panels/samples/*_peec_bem.json
src/radia/panels/samples/*_peec_bem.msh
src/radia/panels/samples/*_peec_bem.msh.opt
src/radia/panels/samples/*_peec_bem_Jsurf.sol

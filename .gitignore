examples/KelvinTransformation/docs/Supplement/*.docx
examples/KelvinTransformation/docs/digest/
*.html

# ============================================================================
# Build Directories
# ============================================================================
build*/
# build*/ accidentally matches the build123d/ source directory in the
# radia-mcp package. Re-admit it (the pre-2026-04-21 path under
# src/radia/mcp_server/ is obsolete after the monorepo restructure).
!packages/radia-mcp/src/radia_mcp/build123d/
!docs/build123d_netgen_gmsh_flow/
!docs/build123d_netgen_gmsh_flow/**
!validation_test/build123d_netgen_gmsh_flow/
!validation_test/build123d_netgen_gmsh_flow/**
dist/
radia-*/
!packages/radia-mcp/
*.egg-info/
.eggs/


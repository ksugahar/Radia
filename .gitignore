src/radia/panels/samples/*_peec_ind.msh.opt
src/radia/panels/samples/*_peec_ind_*.sol
src/radia/panels/samples/*_peec_ind_field.vol
src/radia/panels/samples/*_peec_ind_filaments.msh

# PEEC topology cache (SHA256-keyed JSON written by filaments_from_step

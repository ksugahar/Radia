# ============================================================================
# IMPORTANT: PyPI Distribution Files - DO NOT IGNORE
# ============================================================================
# The following files are tracked and required for PyPI distribution:
# - setup.py
# - pyproject.toml
# - MANIFEST.in
# - LICENSE
# - COPYRIGHT.txt
#
# Note: Build_PyPI_Package.ps1 is now ignored (merged into Build_Wheel.ps1)

# MATLAB files (use Python matplotlib instead). Mathematica also uses
# .m for package files; the MCP-shipped basis-function reference under
# packages/radia-mcp/src/radia_mcp/mathematica/ must be tracked.
*.m
!packages/radia-mcp/src/radia_mcp/mathematica/**/*.m


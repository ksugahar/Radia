# Scratch artifacts: use C:\temp, not in-repo temp/
# (global policy — merged into C:\temp 2026-04-21)
temp/
/temp/

# Demo output artifacts (regenerable from the .py script next to them)
examples/**/out_*.png
examples/**/out_*.txt

# Kelvin transformation reference documents (large PDFs, docx)

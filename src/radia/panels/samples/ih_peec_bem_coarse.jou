## Coarse-wp sample for PEEC+BEM 1-way validation (gap=5 deg).
##
## Geometry identical to ih_fem_kelvin_skin.jou (same Cu torus coil +
## cylindrical wp hole + air sphere), but with MUCH coarser meshes
## so BEM assembly is seconds, not minutes.  BEM 1-way P accuracy ~5%.
##
## Mesh sizes:
##   coil:     3 mm tets (coarse; BEM 1-way doesn't use coil mesh)
##   air:      15 mm tets
##   wp hole:  ~6 mm surface triangles (sibc sideset has ~200 tris)
##
## Labels (same convention as ih_fem_kelvin_skin.jou):
##   block 1 = "coil"     (for completeness)
##   block 2 = "air"      (for completeness)
##   sideset 3 = "sibc"   (wp hole boundary; BEM reads this)
##   sideset 1/2 = source/sink (present but unused in 1-way PEEC+BEM)

reset

# === 1. Coil: gapped torus ===================================================
create vertex 0.030000 0 0
create vertex 0.033000 0 0
create vertex 0.030000 0 0.003000
create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full
create surface curve 1
sweep surface 1 axis 0 0 0 0 0 1 angle 355
${coil_vid = Id("volume")}

# === 2. Workpiece cylinder ==================================================
create cylinder radius 0.025000 height 0.025000
${wp_vid = Id("volume")}

# === 3. Air sphere ==========================================================
create sphere radius 0.060000
${air_vid = Id("volume")}

# === 4. Webcut air sphere for mesh seam curves ==============================
${id_before_webcut = Id("volume")}
webcut volume {air_vid} with plane zplane
${air_top = air_vid}
${air_bot = id_before_webcut + 1}

# === 5. Subtract coil + workpiece from air ==================================
subtract volume {coil_vid} {wp_vid} from volume {air_top} {air_bot} keep_tool

# === 6. Imprint + merge ====================================================
imprint volume {coil_vid} {wp_vid} {air_top} {air_bot}
merge volume {coil_vid} {wp_vid} {air_top} {air_bot}

# === 7. STEP export =========================================================
export step "ih_peec_bem_coarse_coil.step" volume {coil_vid} overwrite

# === 8. Mesh (COARSE for fast BEM assembly) =================================
volume {coil_vid} scheme tetmesh
volume {coil_vid} size 0.003
mesh volume {coil_vid}

volume {air_top} {air_bot} scheme tetmesh
volume {air_top} {air_bot} size 0.015
mesh volume {air_top} {air_bot}

# === 9. Blocks =============================================================
block 1 add volume {coil_vid}
block 1 name "coil"
block 2 add volume {air_top} {air_bot}
block 2 name "air"

# === 10. Sidesets ===========================================================
group "coil_gaps" add surface in volume {coil_vid} with area < 0.0001
sideset 1 add surface in coil_gaps with y_coord > -0.001
sideset 1 name "source"
sideset 2 add surface in coil_gaps with y_coord < -0.001
sideset 2 name "sink"

sideset 3 add surface in volume {wp_vid}
sideset 3 name "sibc"

# Coil outer surface (for calc_fem_coilmesh --coil-mode surface-sibc).
# Excludes the gap faces (grouped above as coil_gaps).
group "coil_outer" add surface in volume {coil_vid}
group "coil_outer" remove surface in coil_gaps
sideset 4 add surface in coil_outer
sideset 4 name "coil_surface"

volume {air_top} {air_bot} visibility off

# === 11. Export Netgen .vol =================================================
radia_export netgen "ih_peec_bem_coarse.vol" order 1 overwrite

## FEM-Kelvin sample with FINE coil mesh (skin depth well-resolved)
##
## NOTE: `export step` and `export ...` below write to Cubit's
## CWD (current working directory).  Cubit aprepro has no
## "current journal path" variable, so the .jou cannot self-locate.
## Before playing: either use **File -> Open Journal** (Cubit sets
## CWD to the .jou's folder), or `cd "<this folder>" ; play "this.jou"`.
##
## Same geometry as ih_fem_kelvin_skin.jou but refined coil meshing:
##   Cross-section: 120 intervals -> edge ~ 0.16 mm
##   Volume size  : 0.5 mm (2x finer)
##
## At 7 kHz Cu: delta = 0.79 mm -> ~5 edges per delta (vs ~2.5 before).
## At 7 kHz steel: delta = 0.66 mm -> similar.
##
## Used by validation_test/peec_integration/filament_coil/compare_fem_vs_peec_skin.py
## to verify that A-V L converges toward the PEEC+BR value as the coil
## mesh is refined (see memory sibc_3d_coil_mesh_discovery, 2026-04-14).

reset

# === 1. Coil: gapped torus by sweep =========================================
create vertex 0.030000 0 0
create vertex 0.033000 0 0
create vertex 0.030000 0 0.003000
create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full
create surface curve 1
sweep surface 1 axis 0 0 0 0 0 1 angle 355
${coil_vid = Id("volume")}

# === 2. Workpiece cylinder ==================================================
create cylinder radius 0.025000 height 0.025000
${wp_vid = Id("volume")}

# === 3. Air sphere ==========================================================
create sphere radius 0.060000
${air_vid = Id("volume")}

# === 4. Webcut air sphere for mesh seam curves ==============================
${id_before_webcut = Id("volume")}
webcut volume {air_vid} with plane zplane
${air_top = air_vid}
${air_bot = id_before_webcut + 1}

# === 5. Subtract coil + workpiece from air ==================================
subtract volume {coil_vid} {wp_vid} from volume {air_top} {air_bot} keep_tool

# === 6. Imprint + merge ====================================================
imprint volume {coil_vid} {wp_vid} {air_top} {air_bot}
merge volume {coil_vid} {wp_vid} {air_top} {air_bot}

# === 7. STEP export (coil only, for PEEC comparison) ========================
export step "ih_fem_kelvin_skin_fine_coil.step" volume {coil_vid} overwrite

# === 8. Mesh: FINER coil (skin depth fully resolved) =======================
# Cross-section circles (length ~ 0.019 m < 0.05):
#   120 intervals -> edge ~ 0.16 mm  (delta ~ 0.7 mm -> ~4-5 edges per delta)
# Toroidal arcs (length ~ 0.186 m > 0.05):
#   240 intervals -> edge ~ 0.78 mm
# Volume interior size 0.0005 (0.5 mm) -> tighter grading from 0.16 mm surface
curve in volume {coil_vid} with length < 0.05 interval 120
curve in volume {coil_vid} with length > 0.05 interval 240
volume {coil_vid} scheme tetmesh
volume {coil_vid} size 0.0005
mesh volume {coil_vid}

volume {air_top} {air_bot} scheme tetmesh
volume {air_top} {air_bot} size 0.020
mesh volume {air_top} {air_bot}

# === 9. Blocks (NO workpiece block) ========================================
block 1 add volume {coil_vid}
block 1 name "coil"
block 2 add volume {air_top} {air_bot}
block 2 name "air"

# === 10. Sidesets ===========================================================
group "coil_gaps" add surface in volume {coil_vid} with area < 0.0001
sideset 1 add surface in coil_gaps with y_coord > -0.001
sideset 1 name "source"
sideset 2 add surface in coil_gaps with y_coord < -0.001
sideset 2 name "sink"

sideset 3 add surface in volume {wp_vid}
sideset 3 name "sibc"

volume {air_top} {air_bot} visibility off

delete body 1 to 383
imprint all
merge all
compress

# ============================================================
# Unite the 382 loft segments into a single coil solid
# ============================================================
# After imprint+merge the lofts share faces but are still 382 separate
# volumes -- the PEEC-BEM `filaments_from_step` parser then fails the
# UV-map / per-station-faces / variable-radius-circle dispatch tiers
# and falls back to a degenerate single-cross-section ring (n_filaments
# stuck at n_peri=16, no helical resolution -- 2026-04-29 debug).
# Uniting collapses the 382-loft fragmentation into one continuous
# helical tube which the parser handles cleanly.
unite volume 1 to 382
#{coil_id = Id("volume")}

compress

# ============================================================
# Workpiece + air domain
# ============================================================
# wp: solid cylinder (axis = z), height 150 mm, radius 5 mm.
#     The 3-turn coil winds around z at radius ~0.13 m.
create Cylinder height 0.150 radius 0.005
#{wp_id = Id("volume")}

compress

# Air box: 30 cm cube (compact; coil bbox ~0.27 m diameter so this gives
# only ~1.5 cm clearance outside the coil).  PEEC+BEM ignores the air
# entirely (only wp surface is used).  FEM A-V on this same .vol will
# show a few-percent bn=0 boundary error from the tight air; if better
# FEM accuracy is needed, replace with a sphere + Kelvin shell pair
# (separate ".jou" variant; do NOT edit this one).
brick x 0.300 y 0.300 z 0.300
#{air_id = Id("volume")}

# Carve out coil + wp from the air brick.  `keep_tool` retains the
# tool (coil + wp) at their original IDs and modifies the brick body.
#
# Cubit subtract may RENUMBER the body volume during the operation
# (verified 2026-04-29: post-subtract `Id("volume")` differs from
# pre-subtract `air_id`).  We do NOT rely on the captured air_id
# after this point -- the compress below renames everything back to
# contiguous IDs (1 coil, 2 wp, 3 air) in creation order.
#
# DO NOT use bare `keep` -- that retains BOTH tool and body AND
# creates a NEW volume for the result, leaving the original brick
# orphaned (4 volumes total) with our block 3 'air' assignment
# pointing at the wrong (un-carved) full-brick.  Verified
# 2026-04-29: `keep` produced 4 volumes with vol3='full brick'
# wrongly labelled 'air' (V = 2.7e-2 instead of expected 2.6968e-2).
subtract volume 1 to {wp_id} from volume {air_id} keep_tool
compress
# After compress: vol 1 coil, vol 2 wp, vol 3 air

# ============================================================
# WP HOLE policy (required by both PEEC-BEM and FEM A-V)
# ============================================================
# At IH frequencies (150 kHz on Cu), skin depth is 0.17 mm.  Resolving
# this volumetrically would need 5+ elements / skin = sub-40 um wp
# mesh size, giving tens of millions of tets -- impractical.  Both
# scalar BEM-PEEC and FEM A-V handle the wp via SIBC, which requires:
#   - wp NOT meshed and NOT in any block (it is a HOLE)
#   - sibc sideset on the wp / air interface surfaces
#   - the wp's region becomes a cavity in the air block (already
#     achieved by `subtract ... keep_tool` above, which carves a
#     wp-shaped hole in the air block)
#
# Strategy: keep wp as a separate VOLUME (so the imprint+merge from
# the subtract leaves its surfaces shared with the air cavity), tag
# sibc on those surfaces, then SKIP wp in the meshing step (`mesh
# volume 1 3` instead of `mesh volume all`).  Surfaces shared with
# air get meshed as part of air's boundary; wp's interior stays
# empty.  We do NOT `delete volume 2` because that also removes the
# tagged sibc surfaces from any sideset.
# Tag sibc on the AIR side (vol 3) via a bbox predicate around the wp
# cavity.  Tagging "surface in volume 2" (wp) does NOT propagate to the
# BND triangles emitted by `radia_export netgen` when wp is skipped in
# the mesh step (`mesh volume 1 3`): Cubit's BND triangle export ties
# the sideset to the OWNING volume's mesh.  Since wp isn't meshed, the
# wp-side tag yields zero BND triangles in the .vol -- verified
# 2026-04-29 with `for el in mesh.Elements(BND): cnt[el.index]`.
#
# wp cavity bbox: cylindrical side at xy in [-5, +5] mm, end caps at
# z = +/-75 mm.  All 3 cavity surfaces have centroid within this bbox;
# brick outer faces (centroid at +/-150 mm) and coil-cavity surfaces
# (centroid in coil bbox) are excluded.
sideset 3 add surface in volume 3 with x_coord > -0.006 with x_coord < 0.006 with y_coord > -0.006 with y_coord < 0.006 with z_coord > -0.08 with z_coord < 0.08
sideset 3 name "sibc"

# ============================================================
# Blocks (NO 'work' block per WP HOLE policy)
# ============================================================
# vol 1 coil, vol 3 air.  vol 2 wp is intentionally not blocked.
set duplicate block elements off
block 1 add volume 1
block 1 name "coil"
block 2 add volume 3
block 2 name "air"

# source/sink: the two small disk faces at the coil's lead tips.
# Each disk has area = pi * r_xs^2 = pi * 0.00315^2 = 3.117e-5 m^2.
# Both lead tips are at x_max (+129 mm) on the +X side of the coil
# bbox; they differ only by y sign (one at y=+12.5 mm, the other at
# y=-12.5 mm).
#
# We identify them via Cubit's COMMAND-LANGUAGE `with` predicate
# (NOT APREPRO -- APREPRO can only track Id() at entity creation
# time, but `unite`/`compress`/`subtract` renumber surface IDs and
# the captures become invalid).  Cubit `with` predicates are
# evaluated fresh at the command-parse stage and are immune to
# renumbering -- the standard portable approach per CLAUDE.md
# "Journal File Portability Policy".
sideset 1 add surface in volume 1 with area > 3.1e-5 and area < 3.13e-5 with y_coord > 0
sideset 1 name "source"
sideset 2 add surface in volume 1 with area > 3.1e-5 and area < 3.13e-5 with y_coord < 0
sideset 2 name "sink"

compress

# ============================================================
# Coil-only STEP for the PEEC+BEM workflow
# ============================================================
# Cubit 2025.3 `export step` always writes LENGTH_UNIT = MILLIMETRE in
# the STEP header regardless of input numerics.  But the radia PEEC
# parser reads raw STEP coordinate values as METRES (CLAUDE.md "Unit
# System Policy") -- it ignores the LENGTH_UNIT declaration.  So a
# Cubit-exported STEP with this .jou's m-numerics (0.068 m etc) is
# functionally CORRECT for the parser: the values it sees are m, even
# if the STEP header says mm.  External tools (CAD viewers, OCP) will
# misinterpret as 1000x too small, but PEEC-BEM doesn't go through them.
#
# We export ONLY the coil (single united solid) to a sister STEP so
# `filaments_from_step` sees a clean 1-solid 3-turn helix instead of
# the post-mesh .vol coil block.
export step "3turnCoil_work_coil.step" volume 1 overwrite

# ============================================================
# Mesh sizing per volume (vol 1 coil, vol 3 air; vol 2 wp NOT meshed)
# ============================================================
#   coil (vol 1): 2 mm.  For FEM A-V at 150 kHz Cu, skin depth is
#         0.17 mm, so this coil mesh is 12x coarser than skin -- it
#         resolves only the large-scale current path, not the skin
#         distribution.  Acceptable for PEEC-BEM (which uses
#         filaments from the STEP, not the volumetric coil).  FEM A-V
#         skin-resolution work would need <50 um at the coil surface.
#   air (vol 3): 20 mm in bulk, 1.5 mm at the wp cavity surface (sibc)
#         to capture the 3 helical bands of |H_t|^2 from the coil.
volume 1 size 0.002
volume 3 size 0.020

# Refine air mesh near the wp cavity boundary (sibc sideset).
surface in sideset 3 size 0.0015

volume 1 scheme tetmesh
volume 3 scheme tetmesh
mesh volume 1
mesh volume 3

set echo on
set info on
graphics flush

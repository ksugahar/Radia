@article{HUGON201075,
  title = {Design of arbitrarily homogeneous permanent magnet systems for NMR and MRI: Theory and experimental developments of a simple portable magnet},
  journal = {Journal of Magnetic Resonance},
  volume = {205},
  number = {1},
  pages = {75-85},
  year = {2010},
  issn = {1090-7807},
  doi = {https://doi.org/10.1016/j.jmr.2010.04.003},
  url = {https://www.sciencedirect.com/science/article/pii/S1090780710001059},
  author = {Cedric {Hugon} and Francesca {D’Amico} and Guy {Aubert} and Dimitris {Sakellariou}},
  keywords = {Portable NMR, Portable MRI, Permanent magnets, Passive shimming, Homogeneous fields, Spherical harmonics expansion},
  abstract = {Starting from general results of magnetostatics, we give fundamental considerations on the design and characterization of permanent magnets for NMR based on harmonic analysis and symmetry. We then propose a simple geometry that takes advantage of some of these considerations and discuss the practical aspects of the assembly of a real magnet based on this geometry, involving the characterization of its elements, the optimization of the layout and the correction of residual inhomogeneities due to material and geometry imperfections. We report with this low-cost, light-weight magnet (100euros and 1.8kg including the aluminum frame) a field of 120mT (5.1MHz proton) with a 10ppm natural homogeneity over a sphere of 1.5mm in diameter.}
}


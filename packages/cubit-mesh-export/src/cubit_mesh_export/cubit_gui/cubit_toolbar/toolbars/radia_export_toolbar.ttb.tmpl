<?xml version="1.0" encoding="UTF-8"?>
<WorkflowToolbar version="1.0" name="Radia Export" visible="true">
  <description>Radia mesh export tools for Coreform Cubit.</description>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_netgen.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="Netgen Vol (.vol)">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export a checked curved Netgen .vol mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_gmsh.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="GMSH (.msh)">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export a GMSH mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_nastran.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="Nastran (.bdf)">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export a Nastran BDF mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_vtk.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="VTK (.vtk)">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export a VTK mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_femeem.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="FEMEEM">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export a first-order FEMEEM mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
  <WTButton visible="true">
    <WPythonScriptAction>
      <filename>@TOOLBAR_INSTALL_DIR@/scripts/export_meg.py</filename>
      <UIfilename></UIfilename>
      <workingdir>@TOOLBAR_INSTALL_DIR@/scripts</workingdir>
      <WAction name="MEG (ELF/MAGIC)">
        <icon>@TOOLBAR_INSTALL_DIR@/icons/radia_export.svg</icon>
        <description>Export an ELF/MAGIC MEG mesh.</description>
      </WAction>
    </WPythonScriptAction>
  </WTButton>
</WorkflowToolbar>

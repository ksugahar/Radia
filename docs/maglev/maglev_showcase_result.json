      "source_preview": "\nimport json, os\nREL = \"../../examples/maglev\"\n\ndef head(fn, keys):\n    p = os.path.join(REL, fn)\n    if not os.path.isfile(p):\n        print(f\"(missing {fn})\"); return\n    d = json.load(open(p))\n    print(f\"--- {fn} ---\")\n    for k in keys:\n        if isinstance(d, dict) and k in d:\n            print(f\"  {k}: {d[k]}\")\n    print()\n\n# Headline numbers from the committed result JSON (no re-solve).\nhead(\"cube_alpha_sweep_results.json\", [\"geometry\", \"sigma_S_per_m\", \"n_freq\", \"freqs_Hz\"])\nhead(\"rotating_magnet_eddy_results.json\",\n     [\"Rm\", \"source_only_error\", \"cln_vs_fem_error\", \"J_rms_A_per_m2\", \"F_N\"])\nhead(\"team28/team28_cln_sweep_results.json\", [\"n_height\", \"equilibrium_height_mm\", \"speedup\"])\nhead(\"sphere/maglev_sphere_force_results.json\", [\"radius_m\", \"sigma_S_per_m\", \"n_freq\"])\n",

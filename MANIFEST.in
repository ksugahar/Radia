# Include license and copyright files
include LICENSE
include COPYRIGHT.txt

# Include documentation
include README.md
include BUILD.md


# Include Python utilities
recursive-include src/radia *.py

# Exclude Path B reference implementation (requires netgen fork, not for distribution)
exclude src/radia/panels/cub5_to_vol.py

# Include Cubit toolbar panels and sample .jou files
recursive-include src/radia/panels *.txt *.ui *.jou
recursive-include src/radia/panels/cubit_toolbar *.tmpl *.py *.svg

# Include conventions document
include src/radia/CONVENTIONS.md

# Include compiled extension modules (.pyd) and Cubit plugin (.ccm).
# Note (radia 4.80.0): the .ccl was removed (Qt5 GUI deleted; PySide6
# toolbar at src/radia/panels/radia_export_menu.py replaces it).
recursive-include src/radia *.pyd
recursive-include src/radia *.dll *.so *.dylib
recursive-include src/radia *.ccm

# Include examples
recursive-include examples *.py
recursive-include examples *.pvsm
recursive-include examples *.md
recursive-include examples *.vtk

# Include Cubit example sample files
recursive-include examples/cubit *.exo *.msh *.bdf *.meg *.vol *.jou

# Include tests
recursive-include tests *.py
include tests/README.md

# Include documentation
recursive-include docs *.md

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude .DS_Store
global-exclude *.swp

# Exclude large output files
global-exclude *.vtu
global-exclude *_field_compare.vtu

# Exclude build directories
prune build
prune dist
prune .git
prune .vscode
prune .idea

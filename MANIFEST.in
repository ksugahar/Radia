# Include license and copyright files
include LICENSE
include COPYRIGHT.txt

# Include documentation
include README.md
include BUILD.md


# Include Python utilities
recursive-include src/radia *.py

# Include Cubit toolbar panels and sample .jou files
recursive-include src/radia/panels *.txt *.ui *.jou

# Include conventions document
include src/radia/CONVENTIONS.md

# Include compiled extension modules (.pyd) and Cubit plugins (.ccm, .ccl)
recursive-include src/radia *.pyd
recursive-include src/radia *.ccm
recursive-include src/radia *.ccl

# Include examples
recursive-include examples *.py
recursive-include examples *.pvsm
recursive-include examples *.md
recursive-include examples *.vtk

# Include Cubit example sample files
recursive-include examples/cubit *.exo *.msh *.bdf *.meg *.vol *.jou

# Include tests
recursive-include tests *.py
include tests/README.md

# Include documentation
recursive-include docs *.md

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude .DS_Store
global-exclude *.swp

# Exclude large output files
global-exclude *.vtu
global-exclude *_field_compare.vtu

# Exclude build directories
prune build
prune dist
prune .git
prune .vscode
prune .idea

@echo off
setlocal enabledelayedexpansion
REM Build the native 64-bit Eqnedit64 application.
REM ASCII ONLY: cmd.exe reads batch files using the active ANSI code page.

where cl >nul 2>&1
if not errorlevel 1 goto have_cl

set "PFX86=%ProgramFiles(x86)%"
set "VSWHERE=!PFX86!\Microsoft Visual Studio\Installer\vswhere.exe"
set "VCVARS="
if exist "!VSWHERE!" for /f "usebackq delims=" %%I in (`"!VSWHERE!" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do (
    if exist "%%I\VC\Auxiliary\Build\vcvars64.bat" set "VCVARS=%%I\VC\Auxiliary\Build\vcvars64.bat"
)
if not defined VCVARS (
    echo [ERROR] vcvars64.bat not found. Install the Visual Studio C++ build tools.
    exit /b 1
)
call "!VCVARS!" >nul 2>&1

:have_cl
cd /d "%~dp0.."
echo [INFO] building build\Eqnedit64_asan.exe

REM Stamp the build so a running window can be told apart from an old copy
REM lying around in a scratch directory.  That is not hypothetical: a
REM day-old build left in C:\temp was mistaken for a regression.
set "STAMP=unknown"
for /f "usebackq delims=" %%H in (`git -C "%~dp0.." rev-parse --short HEAD 2^>nul`) do set "STAMP=%%H"
for /f "usebackq delims=" %%D in (`pwsh -NoProfile -Command "(Get-Date).ToString('yyyy-MM-dd HH:mm')"`) do set "BUILT=%%D"
> src\build_stamp.h echo /* Generated by build_eqnedt64.bat -- do not edit. */
>> src\build_stamp.h echo #define EQNEDIT64_BUILD_COMMIT "!STAMP!"
>> src\build_stamp.h echo #define EQNEDIT64_BUILD_TIME "!BUILT!"

rc /nologo /fo build\Eqnedit64.res src\eqnedit64.rc
if errorlevel 1 ( echo [ERROR] Eqnedit64 resources failed & exit /b 1 )

cl /nologo /O2 /W4 /WX /EHsc /MT /fsanitize=address /Zi /std:c++17 /utf-8 ^
   /D_CRT_SECURE_NO_WARNINGS /DUNICODE /D_UNICODE /I src ^
   /TP src\eqnedt64_app.cpp src\equation_edit.cpp src\equation_render.cpp ^
       src\tex_parser.cpp src\equation_node.cpp src\latex_emitter.cpp ^
       src\mathml_emitter.cpp src\math_symbols.cpp src\palettes.cpp src\tex_document.cpp ^
   /Fe:build\Eqnedit64_asan.exe /Fo:build\ /Fd:build\Eqnedit64.pdb ^
   /link /SUBSYSTEM:WINDOWS user32.lib gdi32.lib comctl32.lib comdlg32.lib shell32.lib ^
         ole32.lib imm32.lib windowscodecs.lib build\Eqnedit64.res
if errorlevel 1 ( echo [ERROR] Eqnedit64 build failed & exit /b 1 )

if not exist build\Eqnedit64_asan.exe (
    echo [ERROR] build\Eqnedit64_asan.exe was not produced
    exit /b 1
)
echo [OK] build\Eqnedit64_asan.exe

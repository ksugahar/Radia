{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radia:validation-record:v3",
  "title": "Historical validation record (no numerical replay)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "question",
    "outcome",
    "source",
    "covered_paths",
    "entry",
    "environment",
    "result",
    "key_values",
    "limits",
    "timing_s",
    "status",
    "stale_reason",
    "superseded_by",
    "private",
    "milestone",
    "claim",
    "date",
    "radia_version",
    "conditions",
    "comparison",
    "covered_sha256",
    "category",
    "supersedes"
  ],
  "properties": {
    "schema": {
      "const": "radia.validation-record.v3"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]+/)+[0-9]{8}_[A-Za-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "investigation",
        "speedup",
        "comparison",
        "acceptance",
        "parity"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "observed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_sha",
        "dirty",
        "native_sha256",
        "wheel_sha256",
        "source_only",
        "provenance"
      ],
      "properties": {
        "repo_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "const": false
        },
        "native_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "wheel_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_only": {
          "type": "boolean"
        },
        "provenance": {
          "enum": [
            "exact",
            "pre-rewrite"
          ]
        }
      }
    },
    "covered_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "script_sha256",
        "command"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_role",
        "os",
        "python",
        "threads"
      ],
      "properties": {
        "host_role": {
          "enum": [
            "neutral-cpu",
            "neutral-gpu",
            "build",
            "validation"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "ngsolve": {
          "type": [
            "string",
            "null"
          ]
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "key_values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "timing_s": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "status": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "stale_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "private": {
      "const": false
    },
    "milestone": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\r\\n]+"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\r\\n]+"
    },
    "date": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "radia_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "mesh",
        "hardware"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "mesh": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "independence"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "covered_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "[0-9a-f]{64}"
      },
      "required": []
    },
    "category": {
      "enum": [
        "milestone",
        "adoption",
        "accuracy-champion",
        "speed",
        "scale"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "improves",
              "corrects",
              "replaces"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "relation",
          "reason"
        ]
      },
      "minItems": 0
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "analytic",
                    "independent-route",
                    "measurement",
                    "benchmark"
                  ]
                },
                "citation": {
                  "type": "string",
                  "minLength": 1
                },
                "bib_key": {
                  "type": "string",
                  "minLength": 1
                },
                "symbolic_verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "[0-9a-f]{64}"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ]
                },
                "independence": {
                  "type": "string",
                  "minLength": 1
                },
                "shared_components": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "uncertainty": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "citation"
              ]
            },
            "quantity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "definition": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "definition",
                "unit"
              ]
            },
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "id",
                  "parameters"
                ]
              },
              "minItems": 2
            },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                  },
                  "level_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                    },
                    "minItems": 2
                  },
                  "axis": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                  },
                  "direction": {
                    "enum": [
                      "increasing",
                      "decreasing"
                    ]
                  },
                  "rate_model": {
                    "enum": [
                      "log-ratio",
                      "log-per-unit"
                    ]
                  },
                  "minimum_rate": {
                    "type": "number",
                    "minimum": 0
                  },
                  "monotonicity": {
                    "const": "strict-decrease"
                  },
                  "finest_threshold": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operator": {
                        "enum": [
                          "lt",
                          "le",
                          "recorded-only"
                        ]
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "operator"
                    ]
                  },
                  "expected_theory": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "norm": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "assumptions": {
                        "type": "string",
                        "minLength": 1
                      },
                      "limitations": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "model",
                      "norm",
                      "source",
                      "assumptions",
                      "limitations"
                    ]
                  }
                },
                "required": [
                  "id",
                  "level_ids",
                  "axis",
                  "direction",
                  "rate_model",
                  "minimum_rate",
                  "monotonicity",
                  "finest_threshold",
                  "expected_theory"
                ]
              },
              "minItems": 1
            },
            "failure_definition": {
              "type": "string",
              "minLength": 1
            },
            "saturation_policy": {
              "const": "blocks-pass"
            },
            "residual_threshold": {
              "type": "number",
              "minimum": 0
            },
            "threshold_verification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "reviewer",
                    "literal-constants"
                  ]
                },
                "review_ref": {
                  "type": "string",
                  "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                },
                "script": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "[0-9a-f]{64}"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ]
                },
                "bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "constant": {
                        "type": "string",
                        "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                      },
                      "criterion_pointer": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "constant",
                      "criterion_pointer"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "mode",
                "review_ref"
              ]
            }
          },
          "required": [
            "reference",
            "quantity",
            "variables",
            "levels",
            "series",
            "failure_definition",
            "saturation_policy",
            "residual_threshold",
            "threshold_verification"
          ]
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved_by": {
              "const": "user"
            },
            "approved_on": {
              "type": "string",
              "minLength": 1
            },
            "approval_ref": {
              "type": "string",
              "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
            },
            "criterion_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "rationale_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "scope_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "approved_by",
            "approved_on",
            "approval_ref",
            "criterion_sha256",
            "rationale_sha256",
            "scope_sha256"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_sha": {
              "type": "string",
              "pattern": "[0-9a-f]{40}"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "verdict": {
              "enum": [
                "PASS",
                "FAIL",
                "UNRESOLVED"
              ]
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "error": {
                    "type": "number",
                    "minimum": 0
                  },
                  "relative_residual": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source_sha": {
                    "type": "string",
                    "pattern": "[0-9a-f]{40}"
                  },
                  "mesh_sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  },
                  "runtime_s": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "runtime_note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "parameters",
                  "error",
                  "relative_residual",
                  "source_sha",
                  "mesh_sha256",
                  "runtime_s"
                ]
              },
              "minItems": 2
            }
          },
          "required": [
            "source_sha",
            "artifact_sha256",
            "verdict",
            "levels"
          ]
        },
        "protected_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rationale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inference": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "[A-Za-z][A-Za-z0-9_.-]*"
                  },
                  "kind": {
                    "enum": [
                      "assumes",
                      "coverage",
                      "independence",
                      "reference-verification",
                      "other"
                    ]
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "invalidated_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "recheck": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "statement",
                  "evidence_refs",
                  "invalidated_by",
                  "recheck"
                ]
              }
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "break_conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "[A-Za-z][A-Za-z0-9_.-]*"
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "condition"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "inference",
            "scope",
            "assumptions",
            "depends_on",
            "break_conditions"
          ]
        }
      },
      "required": [
        "feature",
        "criterion",
        "approval",
        "result",
        "protected_by",
        "rationale"
      ]
    },
    "champion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adoption_record": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "id",
            "sha256"
          ]
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "unit"
          ]
        },
        "selected_level_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "source_sha": {
                "type": "string",
                "pattern": "[0-9a-f]{40}"
              },
              "mesh_sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              },
              "artifact": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "[0-9a-f]{64}"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              "error": {
                "type": "number",
                "minimum": 0
              },
              "runtime_s": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "parameters",
              "source_sha",
              "mesh_sha256",
              "artifact",
              "error",
              "runtime_s"
            ]
          }
        }
      },
      "required": [
        "adoption_record",
        "feature",
        "quantity",
        "selected_level_id",
        "selection_reason",
        "levels"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stale"
          }
        }
      },
      "then": {
        "properties": {
          "stale_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "stale_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}

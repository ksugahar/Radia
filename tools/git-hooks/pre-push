#!/bin/bash
# Radia pre-push hook.
#
# TRACKED SOURCE: tools/git-hooks/pre-push
# Installed into .git/hooks/pre-push by `python tools/install_git_hooks.py`
# (run once per clone).  Edit THIS file, not the installed copy, then re-run
# the installer.
#
# CI preflight gate -- on every branch push, send the unpushed candidate to the build target
# and run `tools/ci_preflight_remote.py`. It ABORTS the push if the build target reports a red
# fast contract gate. Native binaries are published only from the exact CI
# artifact by the release workflow; a developer push must never upload mutable
# workstation binaries. Bypass the preflight for an emergency with:
# CI_PREFLIGHT_SKIP=1 git push

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$REPO_ROOT" ] && exit 1
cd "$REPO_ROOT" || exit 1

# All branch pushes are checked, including new PR branches. Git supplies exact
# outgoing SHAs on stdin; the candidate helper never substitutes checkout HEAD.
if [ "${CI_PREFLIGHT_SKIP:-}" = "1" ]; then
    echo "pre-push: WARNING: explicit CI_PREFLIGHT_SKIP bypass" >&2
    exit 0
fi
if [ ! -f tools/pre_push_check.py ]; then
    echo "pre-push: candidate dispatcher missing; update hook source." >&2
    exit 1
fi
# Remove inherited hook-local Git state before bundle/SSH operations.
unset $(git rev-parse --local-env-vars)
# Trust only this checkout for local bundle creation, never every directory.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$REPO_ROOT"
python tools/pre_push_check.py
exit $?

## Closed (360 deg) torus variant of ih_fem_kelvin_skin.jou
##
## Purpose: (2) A-V sanity check — on a closed torus there is no gap
## and no source/sink sideset, so T0 is topologically ill-defined.
## Historical: the PEEC Biot-Savart scattered path (which this sample
## targeted) was retired 2026-04-24.  Sample retained only for the
## analytical closed-torus L reference below. Expected result:
##
##   Analytical closed-torus L (DC, thin wire, GMD = a*exp(-1/4)):
##     L = mu_0 * R * (ln(8R/a) - 7/4) = 99.23 nH  (R=30mm, a=3mm)
##
##   Analytical closed-torus L (HF / skin-effect limit, GMD = a):
##     L = mu_0 * R * (ln(8R/a) - 2)   = 89.81 nH
##
## Required labels (Biot-Savart mode, no source/sink needed):
##   block 1 = "coil"      (closed torus, filaments from STEP)
##   block 2 = "air"       (inner sphere, with coil + workpiece holes)
##   sideset 1 = "sibc"    (hole boundary where workpiece was)
##
## Geometry:
##   Coil:      closed torus, R_major = 0.030 m, R_minor = 0.003 m
##   Workpiece: cylinder R = 0.025 m, H = 0.025 m  (kept to match the
##              gapped sample for apples-to-apples Delta_L comparison)
##   Air:      sphere R = 0.060 m

reset

# === 1. Coil: closed torus by full sweep =====================================
create vertex 0.030000 0 0
create vertex 0.033000 0 0
create vertex 0.030000 0 0.003000
create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full
create surface curve 1
# Full 360 deg sweep -> closed torus (no gap)
sweep surface 1 axis 0 0 0 0 0 1 angle 360
${coil_vid = Id("volume")}

# === 2. Workpiece cylinder ==================================================
create cylinder radius 0.025000 height 0.025000
${wp_vid = Id("volume")}

# === 3. Air sphere ==========================================================
create sphere radius 0.060000
${air_vid = Id("volume")}

# === 4. Webcut air sphere ==================================================
${id_before_webcut = Id("volume")}
webcut volume {air_vid} with plane zplane
${air_top = air_vid}
${air_bot = id_before_webcut + 1}

# === 5. Subtract coil + workpiece from air ==================================
subtract volume {coil_vid} {wp_vid} from volume {air_top} {air_bot} keep_tool

# === 6. Imprint + merge ====================================================
imprint volume {coil_vid} {wp_vid} {air_top} {air_bot}
merge volume {coil_vid} {wp_vid} {air_top} {air_bot}

# === 7. STEP export (coil only, for PEEC filament extraction) ===============
export step "ih_closed_torus_coil.step" volume {coil_vid} overwrite

# === 8. Mesh ==============================================================
curve in volume {coil_vid} with length < 0.05 interval 60
curve in volume {coil_vid} with length > 0.05 interval 180
volume {coil_vid} scheme tetmesh
volume {coil_vid} size 0.001
mesh volume {coil_vid}

volume {air_top} {air_bot} scheme tetmesh
volume {air_top} {air_bot} size 0.020
mesh volume {air_top} {air_bot}

# === 9. Blocks =============================================================
block 1 add volume {coil_vid}
block 1 name "coil"
block 2 add volume {air_top} {air_bot}
block 2 name "air"

# === 10. Sidesets ===========================================================
# NO source/sink sidesets (closed torus, Biot-Savart mode only).
sideset 1 add surface in volume {wp_vid}
sideset 1 name "sibc"

# Coil outer surface for calc_fem_coilmesh (coil SIBC + K_phi source).
# Closed torus has no gap faces, so the whole coil boundary is the
# imposed-current surface.
sideset 2 add surface in volume {coil_vid}
sideset 2 name "coil_surface"

volume {air_top} {air_bot} visibility off

# === Next step: add Kelvin yourself, then export =============================
# Preserved under validation_test/induction_heating/demoted_samples_legacy/
# on 2026-06-29. See README.md. Play ih_closed_torus.py for one-shot
# Kelvin + export, or run manually in Cubit after this .jou finishes:
#   python "from add_kelvin import add_kelvin_cubit"
#   python "add_kelvin_cubit(R=0.060, symmetry=['z'])"
#   export netgen "ih_closed_torus.vol" order 1 overwrite

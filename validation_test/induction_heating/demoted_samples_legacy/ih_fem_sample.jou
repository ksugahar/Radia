## IH FEM sample (NO Kelvin transform): gapped torus coil + cylindrical workpiece
## + LARGE air sphere with a Dirichlet outer-boundary truncation.
##
## This is the simplest FEM variant — no Kelvin shell, no periodic
## identification. The open boundary is approximated by clamping the
## scalar potential to zero on the outer surface of a deliberately
## oversized air sphere. Truncation error scales like (R_coil/R_air)^3
## for the dipole moment of the coil, so we pick R_air ~ 8x R_coil for
## ~0.2% truncation error on the coil terminal inductance.
##
## Use ih_fem_kelvin_sample.jou instead when you need exact open-BC
## (Kelvin transform), or ih_bem_sample.jou for the surface-only BEM
## reference inductance.
##
## Required labels (consumed by calc_fem_kelvin.py):
##   block 1   = "coil"      (gapped torus, source J)
##   block 2   = "workpiece" (cylinder, INTERFACE approach — kept as a
##                            separate volume; SIBC Robin BC applied
##                            on the air|workpiece interface)
##   block 3   = "air"       (carved air sphere with coil + workpiece holes)
##   sideset 1 = "source"    (one gap face on the coil)
##   sideset 2 = "sink"      (other gap face on the coil)
##   sideset 3 = "sibc"      (workpiece outer surface)
##   nodeset 100 = "GND"     (origin vertex; H1 gauge fix)
##
## Geometry:
##   Coil:      gapped torus, R_major = 0.030 m, R_minor = 0.003 m, gap = 5 deg
##              L_air = mu_0 * R * (ln(8R/a) - 2) * (1 - gap/360) = 88.55 nH
##   Workpiece: cylinder R = 0.025 m, H = 0.025 m
##   Air:       sphere R = 0.240 m  (= 8 x R_coil, Dirichlet BC truncation)
##
## Build policy (CLAUDE.md): coil by SWEEP, subtract before merge,
## NO hardcoded volume / surface IDs, identify by area at sideset time.
##
## Run via: Solve -> Radia-NGSolve -> Induction Heating -> Method: FEM

reset

# === 1. Coil: gapped torus by sweep =========================================
create vertex 0.030000 0 0
create vertex 0.033000 0 0
create vertex 0.030000 0 0.003000
create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full
create surface curve 1
sweep surface 1 axis 0 0 0 0 0 1 angle 355
${coil_vid = Id("volume")}

# === 2. Workpiece cylinder ==================================================
# R = 0.025 m, H = 0.025 m, centered at origin (z = -0.0125 to +0.0125).
create cylinder radius 0.025000 height 0.025000
${wp_vid = Id("volume")}

# === 3. Air sphere ==========================================================
# R = 0.240 m (8 x coil major radius). The Dirichlet truncation at
# this radius gives < 0.5% error on the coil terminal inductance.
# Increase to 0.5 m if you need < 0.1% accuracy.
create sphere radius 0.240000
${air_vid = Id("volume")}

# === 4. Subtract coil + workpiece from the air sphere =======================
# keep_tool keeps the coil and workpiece as separate volumes; the
# air sphere gets two holes that the coil and workpiece fill
# conformally after imprint+merge. The workpiece outer surface
# becomes the SIBC interface.
#
# IMPORTANT: ``subtract A from B keep_tool`` REPLACES the body B
# with a NEW volume whose ID is the next available max+1 — the
# original ``air_vid`` becomes stale immediately. Re-capture the
# new air id with ``Id("volume")`` right after the subtract so the
# rest of the script uses the correct id.
subtract volume {coil_vid} {wp_vid} from volume {air_vid} keep_tool
${air_vid = Id("volume")}

imprint all
merge all

# === 5. Mesh ================================================================
# Coil: tet mesh, BEM-validated density. The interval overrides on
# the tube vs toroidal arcs match ih_bem_sample.jou (~1900 surface
# tris) so the coil terminal inductance is comparable across the
# three IH samples.
curve in volume {coil_vid} with length < 0.05 interval 12
curve in volume {coil_vid} with length > 0.05 interval 48
volume {coil_vid} scheme tetmesh
volume {coil_vid} size 0.003
mesh volume {coil_vid}

# Workpiece cylinder.
volume {wp_vid} scheme tetmesh
volume {wp_vid} size 0.005
mesh volume {wp_vid}

# Air: graded tet mesh — the Dirichlet outer boundary at R=0.240
# only needs ~few hundred tets, inner region gets auto-refinement
# from the coil + workpiece interfaces. size = R_coil for a
# reasonable trade-off.
volume {air_vid} scheme tetmesh
volume {air_vid} size 0.030
mesh volume {air_vid}

# === 6. Blocks ==============================================================
block 1 add volume {coil_vid}
block 1 name "coil"
block 2 add volume {wp_vid}
block 2 name "workpiece"
block 3 add volume {air_vid}
block 3 name "air"

# === 7. Sidesets ============================================================
# Source/sink: coil gap faces. After sweep the start cap = surface 1
# and end cap = surface 3 for this geometry; identify by area in
# your own .jou if you change the parameters.
sideset 1 add surface 1
sideset 1 name "source"
sideset 2 add surface 3
sideset 2 name "sink"

# Workpiece outer surface (SIBC interface).
sideset 3 add surface in volume {wp_vid}
sideset 3 name "sibc"

# === 8. GND nodeset =========================================================
# Pin the H1 scalar potential at the origin. The Dirichlet BC on
# the air outer surface already gauge-fixes the system, but adding
# a single GND node makes the linear system better conditioned.
create vertex 0 0 0
nodeset 100 add vertex {Id("vertex")}
nodeset 100 name "GND"

# Hide air so the user sees only the coil + workpiece in the GUI.
volume {air_vid} visibility off

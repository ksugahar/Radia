# Mixed hex + tet + pyramid mesh: order 1 and order 2 export test
#
# Geometry: brick webcut into 2 volumes
#   Volume 1: hex (map scheme)
#   Volume 2: tet (tetmesh scheme) -- produces pyramids at hex-tet interface
#
# Tests: export gmsh order 1, export gmsh order 2 (NetgenCurver)
#        export jmag_nastran order 1, export jmag_nastran order 2
#        export netgen order 1, export netgen order 2

reset

brick x 2 y 1 z 1
webcut volume 1 with plane xplane imprint merge

volume 1 scheme map
volume 1 size 1
mesh volume 1
volume 2 scheme tetmesh
volume 2 size 5
mesh volume 2

# Volume blocks
block 1 add hex all
block 1 name "map"

block 2 add tet all
block 2 name "tet"

block 3 add pyramid all
block 3 name "pyram"

# Surface blocks
block 4 add tri all
block 4 name "boundary_tri"

block 5 add face all
block 5 name "boundary_face"

Volume all scale 0.001

# Order 1 exports
export gmsh "{DIR}/mixed_o1.msh" order 1 dimension 3 overwrite
export jmag_nastran "{DIR}/mixed_o1.bdf" order 1 dimension 3 overwrite
export netgen "{DIR}/mixed_o1.vol" order 1 overwrite

# Order 2 exports (NetgenCurver)
export gmsh "{DIR}/mixed_o2.msh" order 2 dimension 3 overwrite
export jmag_nastran "{DIR}/mixed_o2.bdf" order 2 dimension 3 overwrite
export netgen "{DIR}/mixed_o2.vol" order 2 overwrite

{
  "schema": "radia.cubit-vol-accuracy-cases.v1",
  "description": "Moderately complex Cubit CAD models used to learn .vol geometric-volume accuracy.",
  "orders": [1, 2, 3],
  "cases": [
    {
      "case_id": "perforated_flange",
      "role": "acceptance",
      "description": "Annular flange with a central bore and four through bolt holes.",
      "geometry_family": "multi_tool_boolean_cut",
      "mesh_family": "tet",
      "features": ["cylinder", "central_bore", "four_bolt_holes", "repeated_boolean_subtract"],
      "material": "perforated_flange",
      "boundary": "outer",
      "commands": [
        "reset",
        "create cylinder height 0.02 radius 0.06",
        "create cylinder height 0.04 radius 0.025",
        "create cylinder height 0.04 radius 0.006",
        "move volume 3 x 0.04 y 0",
        "create cylinder height 0.04 radius 0.006",
        "move volume 4 x -0.04 y 0",
        "create cylinder height 0.04 radius 0.006",
        "move volume 5 x 0 y 0.04",
        "create cylinder height 0.04 radius 0.006",
        "move volume 6 x 0 y -0.04",
        "subtract volume 2 3 4 5 6 from volume 1",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.009",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"perforated_flange\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "slotted_busbar",
      "role": "acceptance",
      "description": "Thin busbar with three circular holes and an open edge notch.",
      "geometry_family": "mixed_open_closed_boolean_cut",
      "mesh_family": "tet",
      "features": ["thin_solid", "three_through_holes", "edge_notch", "multi_tool_boolean_subtract"],
      "material": "slotted_busbar",
      "boundary": "outer",
      "commands": [
        "reset",
        "create brick x 0.20 y 0.08 z 0.012",
        "create cylinder height 0.03 radius 0.009",
        "move volume 2 x -0.065",
        "create cylinder height 0.03 radius 0.009",
        "create cylinder height 0.03 radius 0.009",
        "move volume 4 x 0.065",
        "create brick x 0.045 y 0.045 z 0.03",
        "move volume 5 y 0.04",
        "subtract volume 2 3 4 5 from volume 1",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.010",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"slotted_busbar\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "stepped_spacer",
      "role": "acceptance",
      "description": "Boolean-united stepped flange with a central bore and four bolt holes.",
      "geometry_family": "union_and_multi_tool_boolean_cut",
      "mesh_family": "tet",
      "features": ["stepped_union", "central_bore", "four_bolt_holes", "curved_face_intersections"],
      "material": "stepped_spacer",
      "boundary": "outer",
      "commands": [
        "reset",
        "create cylinder height 0.02 radius 0.055",
        "create cylinder height 0.035 radius 0.032",
        "move volume 2 z 0.02",
        "unite volume 1 2",
        "compress",
        "create cylinder height 0.08 radius 0.012",
        "create cylinder height 0.04 radius 0.005",
        "move volume 3 x 0.038 y 0",
        "create cylinder height 0.04 radius 0.005",
        "move volume 4 x -0.038 y 0",
        "create cylinder height 0.04 radius 0.005",
        "move volume 5 x 0 y 0.038",
        "create cylinder height 0.04 radius 0.005",
        "move volume 6 x 0 y -0.038",
        "subtract volume 2 3 4 5 6 from volume 1",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.008",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"stepped_spacer\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "loft_circle_to_rectangle",
      "role": "acceptance",
      "description": "Lofted transition between a circular and rectangular section.",
      "geometry_family": "trimmed_loft",
      "mesh_family": "hex_dominant",
      "features": ["loft", "topology_transition", "curved_trimmed_faces", "mapped_mesh"],
      "material": "loft_transition",
      "boundary": "outer",
      "commands": [
        "reset",
        "create surface rectangle width 1 height 1 zplane",
        "create surface circle radius 1 zplane",
        "move surface 1 z 1 include_merged",
        "create volume loft surface 2 1",
        "delete body 1 2",
        "compress",
        "volume 1 size auto factor 9",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"loft_transition\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "half_torus_terminal",
      "role": "acceptance",
      "description": "Webcut half torus with two trimmed terminal faces.",
      "geometry_family": "trimmed_sweep",
      "mesh_family": "tet",
      "features": ["torus", "double_curvature", "webcut", "terminal_faces"],
      "material": "half_torus",
      "boundary": "outer",
      "commands": [
        "reset",
        "create torus major radius 0.10 minor radius 0.025",
        "webcut volume 1 with plane xplane noimprint nomerge",
        "delete volume 2",
        "volume 1 scheme tetmesh",
        "volume 1 size auto factor 5",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"half_torus\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "gapped_torus_order3_coarse",
      "role": "diagnostic_challenge",
      "description": "A 355-degree swept torus at the production order-2 surface resolution; volume remains accurate while the order-3 map folds locally.",
      "geometry_family": "under_resolved_near_periodic_sweep",
      "mesh_family": "tet",
      "features": ["circular_profile", "355_degree_sweep", "trimmed_terminal_faces", "order3_resolution_challenge"],
      "material": "gapped_torus_coarse",
      "boundary": "outer",
      "commands": [
        "reset",
        "create vertex 0.030000 0 0",
        "create vertex 0.033000 0 0",
        "create vertex 0.030000 0 0.003000",
        "create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full",
        "create surface curve 1",
        "sweep surface 1 axis 0 0 0 0 0 1 angle 355",
        "curve in volume 1 with length < 0.05 interval 12",
        "curve in volume 1 with length > 0.05 interval 48",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.003",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"gapped_torus_coarse\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "gapped_torus_order3_refined",
      "role": "acceptance",
      "description": "The same 355-degree swept torus refined to remove the cubic-map folds.",
      "geometry_family": "refined_near_periodic_sweep",
      "mesh_family": "tet",
      "features": ["circular_profile", "355_degree_sweep", "trimmed_terminal_faces", "order3_refinement"],
      "material": "gapped_torus_refined",
      "boundary": "outer",
      "commands": [
        "reset",
        "create vertex 0.030000 0 0",
        "create vertex 0.033000 0 0",
        "create vertex 0.030000 0 0.003000",
        "create curve arc center vertex 1 vertex 2 vertex 3 normal 0 1 0 full",
        "create surface curve 1",
        "sweep surface 1 axis 0 0 0 0 0 1 angle 355",
        "curve in volume 1 with length < 0.05 interval 16",
        "curve in volume 1 with length > 0.05 interval 64",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.00225",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"gapped_torus_refined\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    },
    {
      "case_id": "cylinder_sphere_boundary_layer",
      "role": "acceptance",
      "description": "Boolean-united cylinder and sphere with a curved boundary-layer mesh.",
      "geometry_family": "boolean_union_boundary_layer",
      "mesh_family": "tet_wedge",
      "features": ["boolean_union", "sphere_cylinder_transition", "boundary_layer", "mixed_tet_wedge"],
      "material": "compound_shell",
      "boundary": "outer",
      "commands": [
        "reset",
        "create cylinder height 1 radius 0.5",
        "create sphere radius 0.5",
        "move volume 2 z 0.5 include_merged",
        "unite volume all",
        "compress",
        "create boundary_layer 1",
        "modify boundary_layer 1 uniform height 0.02 growth 1.2 layers 3",
        "modify boundary_layer 1 add surface 1 volume 1 surface 3 volume 1",
        "modify boundary_layer 1 continuity on",
        "volume 1 scheme tetmesh",
        "volume 1 size 0.2",
        "mesh volume 1",
        "block 1 add volume 1",
        "block 1 name \"compound_shell\"",
        "sideset 1 add surface all",
        "sideset 1 name \"outer\""
      ]
    }
  ]
}

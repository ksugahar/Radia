{
  "schema": "radia.test-tier-manifest.v1",
  "impact_rules": {
    "src/matlab/radia_mex.cpp": ["tests/test_sparsesolv_matlab_contract.py"],
    "matlab/+radia/+sparsesolv/": ["tests/test_sparsesolv_matlab_contract.py"],
    "matlab/python_api_parity_manifest.json": ["tests/test_sparsesolv_matlab_contract.py"],
    "Build.ps1": ["tests/test_build_failure_propagation.py"],
    ".github/workflows/sparsesolv.yml": ["tests/test_sparsesolv_ci_contract.py"],
    "tools/ci_preflight_mdx.py": ["tests/test_ci_preflight_mdx.py"],
    "tools/release_quad.py": ["tests/test_release_quad_state.py", "tests/test_release_quad_editable_source.py", "tests/test_release_quad_optuna_candidate.py", "tests/test_mdx_runner_pool.py"],
    "tools/verify_simulink_release.py": ["tests/test_simulink_release_package.py"],
    "tools/ci_preflight.py": ["tests/test_ci_preflight_scope.py"],
    "tools/run_test_tier.py": ["tests/test_run_test_tier.py"]
  },
  "profiles": {
    "fast-contracts": {
      "description": "Pure source, policy, package, and public-notebook contracts for every push.",
      "max_elapsed_seconds": 60,
      "paths": [
        "tests/test_ci_execution_policy.py",
        "tests/test_ci_monitor.py",
        "tests/test_mdx_runner_pool.py",
        "tests/test_release_quad_optuna_candidate.py",
        "tests/test_test_tier_policy.py",
        "tests/test_run_test_tier.py",
        "tests/test_docs_notebook_contract.py",
        "tests/test_release_workflow_ref_gate.py",
        "tests/test_wheel_package_policy.py",
        "tests/test_application_interface_manifest.py",
        "tests/axifem/test_docs_notebook_evidence.py"
      ]
    },
    "native-smoke": {
      "description": "Fast contracts plus deterministic native import and field regression checks.",
      "extends": "fast-contracts",
      "max_elapsed_seconds": 120,
      "paths": [
        "tests/test_simple.py",
        "tests/test_radia.py",
        "tests/test_meshless_relaxation_contract.py",
        "tests/test_version_consistency.py",
        "tests/test_vim_api_names.py",
        "src/ext/sparsesolv/tests/test_sparsesolv.py"
      ]
    },
    "sparsesolv": {
      "description": "Required native AMS, AMG and Krylov solver regressions.",
      "max_elapsed_seconds": 120,
      "paths": ["src/ext/sparsesolv/tests/test_sparsesolv.py"]
    }
  }
}

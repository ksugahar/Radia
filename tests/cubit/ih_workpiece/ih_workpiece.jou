## Cylindrical workpiece for IH (BEM-SIBC) eddy current analysis
## Coil is analytical (Biot-Savart), only the workpiece is meshed.
##
## Usage in Cubit:
##   playback "ih_workpiece.jou"
##
## Computation (no Cubit needed):
##   python calc_heating_bem.py --vol ih_workpiece.vol \
##       --coil-radius 0.030 --frequency 7000 --sigma 2e6

reset

## Cylindrical workpiece: R=10mm, H=20mm
create cylinder radius 0.010 height 0.020

## Mesh
volume 1 scheme tetmesh
volume 1 size auto factor 5
mesh volume 1

## Material block (workpiece volume)
block 1 add volume 1
block 1 name "workpiece"

## Boundary sideset: entire workpiece surface (for BEM-SIBC)
sideset 1 add surface all
sideset 1 name "wp_surface"

## Export netgen .vol (order 2 for curved cylinder)
export netgen "ih_workpiece.vol" order 2 overwrite
